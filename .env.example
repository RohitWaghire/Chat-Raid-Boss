# All optional. With none set, the app runs fully: live chat for any public channel plus canned boss lines.
# AI boss narrator (OpenAI Responses API)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Twitch Helix lookups (channel avatar and live status). Create an app at https://dev.twitch.tv/console
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional: Channel Points power-ups via EventSub. A user access token for the broadcaster
# with scope channel:read:redemptions (kept server-side, never sent to the overlay).
TWITCH_USER_TOKEN=
